<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical" id="root">
            <children>
                <flow-layout direction="vertical" id="window">
                    <children>
                        <flow-layout direction="horizontal" id="category-tab">
                            <children>
                                <flow-layout direction="horizontal" id="category-tab-left">
                                    <children>
                                        <button id="options-button">
                                            <sizing>
                                                <vertical method="fill">100</vertical>
                                                <horizontal method="fill">30</horizontal>
                                            </sizing>
                                            <text>Options</text>
                                        </button>

                                        <button id="other-button">
                                            <sizing>
                                                <vertical method="fill">100</vertical>
                                                <horizontal method="fill">30</horizontal>
                                            </sizing>
                                            <text>Other</text>
                                        </button>

                                    </children>

                                    <sizing>
                                        <vertical method="fill">100</vertical>
                                        <horizontal method="fill">50</horizontal>
                                    </sizing>
                                    <horizontal-alignment>left</horizontal-alignment>
                                    <gap>6</gap>
                                </flow-layout>

                                <flow-layout direction="horizontal" id="category-tab-right">
                                    <children>
                                        <button id="info-button">
                                            <sizing>
                                                <vertical method="fixed">13</vertical>
                                                <horizontal method="fixed">13</horizontal>
                                            </sizing>
                                        </button>
                                    </children>

                                    <sizing>
                                        <vertical method="fill">100</vertical>
                                        <horizontal method="fill">50</horizontal>
                                    </sizing>
                                    <horizontal-alignment>right</horizontal-alignment>
                                    <vertical-alignment>center</vertical-alignment>
                                    <gap>6</gap>
                                    <allow-overflow>true</allow-overflow>
                                </flow-layout>
                            </children>

                            <sizing>
                                <vertical method="fill">15</vertical>
                                <horizontal method="fill">100</horizontal>
                            </sizing>
                            <padding>
                                <horizontal>12</horizontal>
                                <vertical>6</vertical>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <vertical-alignment>center</vertical-alignment>
                            <allow-overflow>true</allow-overflow>
                        </flow-layout>

                        <flow-layout direction="horizontal" id="separator">

                            <children/>
                            <sizing>
                                <vertical method="fixed">9</vertical>
                                <horizontal method="fill">100</horizontal>
                            </sizing>

                            <surface>
                                <vanilla-translucent/>
                            </surface>
                        </flow-layout>

                        <flow-layout direction="horizontal" id="content-tab">
                            <children>
                                <flow-layout direction="vertical" id="settings-container">
                                    <children></children>

                                    <sizing>
                                        <horizontal method="fixed">186</horizontal>
                                        <vertical method="fill">100</vertical>
                                    </sizing>
                                    <gap>6</gap>
                                    <padding>
                                        <top>1</top>
                                    </padding>
                                </flow-layout>

                                <flow-layout direction="vertical" id="majin">
                                    <children></children>

                                    <sizing>
                                        <horizontal method="fixed">100</horizontal>
                                        <vertical method="fixed">128</vertical>
                                    </sizing>
                                </flow-layout>
                            </children>

                            <sizing>
                                <vertical method="fill">80</vertical>
                                <horizontal method="fill">100</horizontal>
                            </sizing>
                            <padding>
                                <horizontal>12</horizontal>
                                <vertical>6</vertical>
                            </padding>
                            <horizontal-alignment>right</horizontal-alignment>
                            <vertical-alignment>center</vertical-alignment>
                            <gap>8</gap>
                        </flow-layout>
                    </children>

                    <padding>
                        <all>8</all>
                    </padding>
                    <sizing>
                        <!-- roughly 2x and 1.1x the sizes of the survival inventory -->
                        <horizontal method="fixed">334</horizontal>
                        <vertical method="fixed">195</vertical>
                    </sizing>
                    <allow-overflow>true</allow-overflow>
                </flow-layout>
            </children>

            <allow-overflow>true</allow-overflow>
            <horizontal-alignment>center</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
            <margins>
                <right>1</right>
            </margins>
        </flow-layout>
    </components>

    <templates>
        <template name="setting-entry">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="horizontal">
                        <children>
                            <flow-layout direction="vertical">
                                <children>
                                    <label>
                                        <text>{{name}}</text>
                                    </label>
                                    <label>
                                        <text>{{desc}}</text>
                                        <color>#a87ca8</color>
                                    </label>
                                </children>

                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="fill">100</vertical>
                                </sizing>
                                <horizontal-alignment>left</horizontal-alignment>
                                <vertical-alignment>center</vertical-alignment>
                                <gap>4</gap>
                            </flow-layout>
                        </children>

                        <padding>
                            <left>4</left>
                        </padding>
                        <sizing>
                            <horizontal method="fill">75</horizontal>
                            <vertical method="fill">100</vertical>
                        </sizing>
                        <horizontal-alignment>left</horizontal-alignment>
                        <vertical-alignment>center</vertical-alignment>
                    </flow-layout>
                    <flow-layout direction="horizontal">
                        <children>
                            <button id="{{configId}}">
                                <text/>
                                <sizing>
                                    <horizontal method="fill">50</horizontal>
                                    <vertical method="fill">50</vertical>
                                </sizing>
                            </button>
                        </children>

                        <padding>
                            <right>4</right>
                        </padding>
                        <sizing>
                            <horizontal method="fill">25</horizontal>
                            <vertical method="fill">100</vertical>
                        </sizing>
                        <horizontal-alignment>right</horizontal-alignment>
                        <vertical-alignment>center</vertical-alignment>
                        <allow-overflow>true</allow-overflow>
                    </flow-layout>
                </children>

                <horizontal-alignment>left</horizontal-alignment>
                <vertical-alignment>center</vertical-alignment>
                <sizing>
                    <horizontal method="fill">100</horizontal>
                    <vertical method="fill">25</vertical>
                </sizing>
                <allow-overflow>true</allow-overflow>
            </flow-layout>
        </template>
    </templates>
</owo-ui>